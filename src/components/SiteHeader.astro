---
import { ThemeSwitch } from './blog/ThemeSwitch';
import { siteName } from '../lib/site';

const pathname = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const homeCurrent = pathname === '/' ? 'page' : undefined;
const blogCurrent = pathname.startsWith('/blog/') ? 'page' : undefined;
---

<header class="flex items-center gap-4 px-4 py-3">
  <a href="/" class="font-medium">{siteName}</a>
  <nav class="flex gap-3">
    <a href="/" aria-current={homeCurrent}>ホーム</a>
    <a href="/blog/" aria-current={blogCurrent}>記事</a>
  </nav>
  <div class="ml-auto">
    <ThemeSwitch client:load transition:persist="theme-switch" />
  </div>
</header>
