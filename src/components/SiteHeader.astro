---
import { ThemeSwitch } from './blog/ThemeSwitch';
import { siteWordmark } from '../lib/site';

const pathname = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const blogCurrent = pathname.startsWith('/blog/') ? 'page' : undefined;
---

<header class="flex items-center gap-4 py-8">
  <a href="/" class="flex items-center gap-2 font-medium">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 40 32"
      width="20"
      height="16"
      aria-hidden="true"
      class="shrink-0"
    >
      <rect x="4" y="0" width="24" height="8" fill="currentColor"></rect>
      <rect x="16" y="12" width="24" height="8" fill="#a8602a"></rect>
      <rect x="0" y="24" width="18" height="8" fill="currentColor"></rect>
      <rect x="26" y="24" width="8" height="8" fill="currentColor"></rect>
    </svg>
    {siteWordmark}
  </a>
  <a href="/blog/" class="ml-auto" aria-current={blogCurrent}>blog</a>
  <ThemeSwitch client:load transition:persist="theme-switch" />
</header>
