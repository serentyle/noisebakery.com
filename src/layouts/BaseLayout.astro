---
import { ClientRouter } from 'astro:transitions';
import '@fontsource/ibm-plex-sans-jp/400.css';
import '@fontsource/ibm-plex-sans-jp/700.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/600.css';
import ThemeScript from '../components/ThemeScript.astro';
import { ThemeSwitch } from '../components/blog/ThemeSwitch';
import { RuleFigure } from '../components/RuleFigure';
import { copyrightLine, siteDescription, siteName } from '../lib/site';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title = siteName, description = siteDescription } = Astro.props;
const pageTitle = title === siteName ? siteName : `${title} | ${siteName}`;
const pathname = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const blogCurrent = pathname.startsWith('/blog/') ? 'page' : undefined;
---

<html lang="ja">
  <head>
    <ThemeScript />
    <ClientRouter />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={siteName} href="/rss.xml" />
  </head>
  <body>
    <div
      class="relative min-h-screen overflow-hidden bg-background font-['IBM_Plex_Sans_JP',system-ui,sans-serif] text-body text-muted-foreground tabular-nums"
    >
      <svg
        class="pointer-events-none absolute inset-0 h-full w-full opacity-[0.09] dark:opacity-20"
        aria-hidden="true"
      >
        <filter id="nb-grain">
          <feTurbulence type="fractalNoise" baseFrequency="0.85" numOctaves="3" stitchTiles="stitch"
          ></feTurbulence>
          <feColorMatrix type="saturate" values="0"></feColorMatrix>
        </filter>
        <rect width="100%" height="100%" filter="url(#nb-grain)"></rect>
      </svg>
      <div class="relative mx-auto w-full max-w-[600px] px-6 pb-16">
        <header class="flex items-center justify-between gap-4 pt-10">
          <a class="flex min-h-11 items-center gap-2.5 text-foreground" href="/">
            <svg aria-hidden="true" width="22" height="22" viewBox="0 0 22 22">
              <rect x="2" y="3" width="12" height="4" fill="currentColor"></rect>
              <rect x="8" y="9" width="12" height="4" fill="#A8602A"></rect>
              <rect x="0" y="15" width="9" height="4" fill="currentColor"></rect>
              <rect x="13" y="15" width="4" height="4" fill="currentColor"></rect>
            </svg>
            <span class="font-mono text-label font-semibold tracking-[-0.01em]">
              noise<span class="font-normal text-muted-foreground">bakery</span>
            </span>
          </a>
          <nav class="flex items-center gap-1 text-label" aria-label="メイン">
            <a
              class="link mr-1.5 py-2.5 aria-[current=page]:text-foreground"
              href="/blog/"
              aria-current={blogCurrent}
            >
              blog
            </a>
            <ThemeSwitch client:load transition:persist="theme-switch" />
          </nav>
        </header>
        <main>
          <slot />
        </main>
        <RuleFigure kind="dither" />
        <footer class="pt-7 text-meta">{copyrightLine(new Date())}</footer>
      </div>
    </div>
  </body>
</html>
