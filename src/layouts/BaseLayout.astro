---
import { ClientRouter } from 'astro:transitions';
import ThemeScript from '../components/ThemeScript.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { Rule } from '../components/Rule';
import { copyrightLine, siteDescription, siteName } from '../lib/site';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title = siteName, description = siteDescription } = Astro.props;
const pageTitle = title === siteName ? siteName : `${title} | ${siteName}`;
---

<html lang="ja">
  <head>
    <ThemeScript />
    <ClientRouter />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={siteName} href="/rss.xml" />
  </head>
  <body>
    <div class="mx-auto w-full max-w-content px-4">
      <SiteHeader />
      <main class="py-6">
        <slot />
      </main>
      <footer class="mt-20 flex flex-col gap-4 pb-12 text-sm text-muted-foreground">
        <Rule kind="dither" />
        <p>{copyrightLine(new Date())}</p>
      </footer>
    </div>
  </body>
</html>
