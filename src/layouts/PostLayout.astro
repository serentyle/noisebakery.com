---
import { Image } from 'astro:assets';
import { TagLink } from '../components/blog/TagLink';
import { RuleFigure } from '../components/RuleFigure';
import BaseLayout from './BaseLayout.astro';
import type { Neighbor, PostSummary, PublishedPost } from '../lib/blog';

interface Props {
  entry: PublishedPost;
  summary: PostSummary;
  neighbors: Neighbor[];
}

const { entry, summary, neighbors } = Astro.props;
const { title, description, heroImage } = entry.data;
---

<BaseLayout title={title} description={description}>
  <article class="pt-14 pb-10">
    <h1 class="m-0 text-title font-bold tracking-[-0.01em]">{title}</h1>
    <div class="mt-2 flex flex-wrap items-baseline gap-x-3 gap-y-1 text-meta">
      <time datetime={summary.iso}>{summary.date}</time>
      {summary.tags.map((tag) => <TagLink tag={tag} />)}
    </div>
    {
      heroImage && (
        <Image
          class="mt-6 block h-auto w-auto max-w-full"
          src={heroImage}
          alt={title}
        />
      )
    }
    <div
      class="mt-10 [&_h2]:mt-12 [&_h2]:mb-3 [&_h2]:text-lg [&_h2]:font-bold [&_p]:mt-0 [&_p]:mb-6 [&_pre]:mb-6 [&_pre]:overflow-x-auto [&_pre]:bg-muted [&_pre]:p-5 [&_pre]:font-mono [&_pre]:text-meta [&_pre]:leading-[1.75]"
    >
      <slot />
    </div>
  </article>
  {
    neighbors.length > 0 && (
      <>
        <RuleFigure kind="macroblock" />
        <nav class="pt-[18px] pb-8" aria-label="前後の記事">
          {neighbors.map((neighbor) => (
            <div class="py-2.5">
              <a class="link" href={neighbor.url}>
                {neighbor.title}
              </a>
              <span class="block text-meta">{neighbor.label}</span>
            </div>
          ))}
        </nav>
      </>
    )
  }
</BaseLayout>
