---
import { Image } from 'astro:assets';
import { Badge } from '@/components/ui/badge';
import BaseLayout from './BaseLayout.astro';
import { formatPostDate } from '@/lib/post-card';
import type { PublishedPost } from '@/lib/blog';

interface Props {
  entry: PublishedPost;
}

const { entry } = Astro.props;
const { title, description, pubDate, tags, heroImage } = entry.data;
---

<BaseLayout title={title} description={description}>
  <article class="flex flex-col gap-6">
    <header class="flex flex-col gap-3">
      <h1 class="text-3xl font-medium">{title}</h1>
      <time datetime={pubDate.toISOString()}>{formatPostDate(pubDate.toISOString())}</time>
      {
        tags.length > 0 && (
          <ul class="flex flex-wrap gap-2">
            {tags.map((tag) => (
              <li>
                <Badge variant="secondary">{tag}</Badge>
              </li>
            ))}
          </ul>
        )
      }
    </header>
    {
      heroImage && (
        <Image
          src={heroImage}
          width={heroImage.width}
          height={heroImage.height}
          alt=""
        />
      )
    }
    <div class="prose dark:prose-invert max-w-none">
      <slot />
    </div>
  </article>
</BaseLayout>
