---
import { Image } from 'astro:assets';
import { RuleFigure } from '../components/RuleFigure';
import BaseLayout from './BaseLayout.astro';
import { getPublishedPosts, postPath } from '../lib/blog';
import { neighborsOf, postSummary, tagListHref } from '../lib/posts';
import type { PublishedPost } from '../lib/blog';

interface Props {
  entry: PublishedPost;
}

const { entry } = Astro.props;
const { title, description, pubDate, tags, heroImage } = entry.data;
const published = await getPublishedPosts();
const summaries = published.map((post) =>
  postSummary({
    url: postPath(post.id),
    title: post.data.title,
    iso: post.data.pubDate.toISOString(),
    tags: post.data.tags,
  }),
);
const index = published.findIndex((post) => post.id === entry.id);
const summary =
  summaries[index] ??
  postSummary({
    url: postPath(entry.id),
    title,
    iso: pubDate.toISOString(),
    tags,
  });
const neighbors = index < 0 ? [] : neighborsOf(summaries, index);
---

<BaseLayout title={title} description={description}>
  <article class="entry">
    <h1>{title}</h1>
    <div class="meta">
      <time datetime={summary.iso}>{summary.date}</time>
      {
        summary.tags.map((tag) => (
          <a class="tag" href={tagListHref(tag)}>
            #{tag}
          </a>
        ))
      }
    </div>
    {
      heroImage && (
        <Image
          class="hero"
          src={heroImage}
          width={heroImage.width}
          height={heroImage.height}
          alt={title}
        />
      )
    }
    <div class="entry-prose">
      <slot />
    </div>
  </article>
  {
    neighbors.length > 0 && (
      <>
        <RuleFigure kind="macroblock" />
        <nav class="neighbors" aria-label="前後の記事">
          {neighbors.map((neighbor) => (
            <div class="row">
              <a href={neighbor.url}>{neighbor.title}</a>
              <span class="neighbor-label">{neighbor.label}</span>
            </div>
          ))}
        </nav>
      </>
    )
  }
</BaseLayout>
