---
import { render } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';
import {
  neighborsOf,
  toPostSummary,
  type Neighbor,
  type PostSummary,
  type PublishedPost,
} from '../../lib/blog';
import { getPublishedPosts } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const summaries = posts.map((post) => toPostSummary(post));
  return posts.map((entry, index) => ({
    params: { slug: entry.id },
    props: { entry, summary: summaries[index], neighbors: neighborsOf(summaries, index) },
  }));
}

interface Props {
  entry: PublishedPost;
  summary: PostSummary;
  neighbors: Neighbor[];
}

const { entry, summary, neighbors } = Astro.props;
const { Content } = await render(entry);
---

<PostLayout entry={entry} summary={summary} neighbors={neighbors}>
  <Content />
</PostLayout>
