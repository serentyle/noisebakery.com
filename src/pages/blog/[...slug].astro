---
import { render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { getPublishedArticles } from '../../lib/collections';
import { neighborsOf, toArticleSummary } from '../../lib/blog';
import type { ArticleSummary, Neighbor, PublishedArticle } from '../../lib/types';

export async function getStaticPaths() {
  const articles = await getPublishedArticles();
  const summaries = articles.map((article) => toArticleSummary(article));
  return articles.map((entry, index) => ({
    params: { slug: entry.id },
    props: { entry, summary: summaries[index], neighbors: neighborsOf(summaries, index) },
  }));
}

interface Props {
  entry: PublishedArticle;
  summary: ArticleSummary;
  neighbors: Neighbor[];
}

const { entry, summary, neighbors } = Astro.props;
const { Content } = await render(entry);
---

<ArticleLayout entry={entry} summary={summary} neighbors={neighbors}>
  <Content />
</ArticleLayout>
