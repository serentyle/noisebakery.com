---
import { TagFilter } from '../../components/blog/TagFilter';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedArticles } from '../../lib/collections';
import { toArticleSummary } from '../../lib/blog';

const articles = (await getPublishedArticles()).map((article) => toArticleSummary(article));
---

<BaseLayout title="記事">
  <TagFilter client:load articles={articles} />
</BaseLayout>
