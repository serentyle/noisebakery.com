---
import { TagFilter } from '../../components/blog/TagFilter';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts, postSummary } from '../../lib/blog';

const posts = (await getPublishedPosts()).map((post) => postSummary(post));
---

<BaseLayout title="記事">
  <TagFilter client:load posts={posts} />
</BaseLayout>
