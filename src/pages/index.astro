---
import { RuleFigure } from '../components/RuleFigure';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublishedPosts, postPath } from '../lib/blog';
import { postSummary } from '../lib/posts';

const posts = (await getPublishedPosts()).slice(0, 5).map((post) =>
  postSummary({
    url: postPath(post.id),
    title: post.data.title,
    iso: post.data.pubDate.toISOString(),
    tags: post.data.tags,
  }),
);
---

<BaseLayout>
  <section class="intro">
    <p>
      <span class="fg">Go</span> と<span class="fg">決済基盤</span>、<span class="fg">コーヒー</span>、ときどき<span class="fg">ボートレース</span>。雑音まじりのまま置いておく技術メモと日々の記録。
    </p>
  </section>
  <RuleFigure kind="trace" />
  <section class="home-list" aria-labelledby="posts-h">
    <h2 id="posts-h">記事</h2>
    {
      posts.length === 0 ? (
        <p>まだ記事がありません。</p>
      ) : (
        posts.map((post) => (
          <div class="row">
            <a class="fg" href={post.url}>
              {post.title}
            </a>
            <time class="home-time" datetime={post.iso}>
              {post.date}
            </time>
          </div>
        ))
      )
    }
    <a class="all-posts" href="/blog/">すべての記事</a>
  </section>
</BaseLayout>
