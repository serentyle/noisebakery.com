---
import { PostList } from '../components/PostList';
import { Rule } from '../components/Rule';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublishedPosts } from '../lib/blog';
import { latestSummaries } from '../lib/post-summary';

const latest = latestSummaries(await getPublishedPosts());
---

<BaseLayout>
  <div class="flex flex-col gap-8">
    <Rule kind="trace" />
    <h1 class="text-sm text-muted-foreground">記事</h1>
    <PostList posts={latest} meta="date" />
    <a href="/blog/" class="text-sm text-muted-foreground">すべての記事</a>
  </div>
</BaseLayout>
