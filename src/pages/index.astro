---
import { RuleFigure } from '../components/RuleFigure';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublishedPosts, postSummary } from '../lib/blog';

const posts = (await getPublishedPosts()).slice(0, 5).map((post) => postSummary(post));
---

<BaseLayout>
  <section class="pt-14 pb-10">
    <p class="m-0">
      <span class="text-foreground">Go</span> と<span class="text-foreground">決済基盤</span>、<span class="text-foreground">コーヒー</span>、ときどき<span class="text-foreground">ボートレース</span>。雑音まじりのまま置いておく技術メモと日々の記録。
    </p>
  </section>
  <RuleFigure kind="trace" />
  <section class="pt-7 pb-8" aria-labelledby="posts-h">
    <h2 id="posts-h" class="mt-0 mb-3 text-label font-normal">記事</h2>
    {
      posts.length === 0 ? (
        <p>まだ記事がありません。</p>
      ) : (
        posts.map((post) => (
          <div class="py-2.5">
            <a class="text-foreground link" href={post.url}>
              {post.title}
            </a>
            <time class="block text-meta" datetime={post.iso}>
              {post.date}
            </time>
          </div>
        ))
      )
    }
    <a class="link mt-2.5 inline-block py-1.5 text-sm" href="/blog/">すべての記事</a>
  </section>
</BaseLayout>
